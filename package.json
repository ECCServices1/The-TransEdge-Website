{
  "name": "thetransedge-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/generate-redirects.mjs",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:copy": "node scripts/check-copy.mjs",
    "tokens:contrast": "node scripts/check-contrast.mjs",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "connect:snapshot": "node scripts/connect-snapshot.mjs",
    "verify": "npm run check:copy && npm run check:brand && npm run tokens:contrast && npm run check:quiet-text && npm run check",
    "check:quiet-text": "node scripts/check-quiet-text.mjs",
    "check:lighthouse-urls": "node scripts/check-lighthouse-urls.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "fonts:subset": "node scripts/subset-brand-fonts.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:noindex": "node scripts/check-noindex.mjs",
    "check:a11y": "node scripts/check-a11y.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "axe-core": "^4.13.0",
    "pagefind": "^1.5.2",
    "playwright-core": "^1.62.1",
    "pptxgenjs": "^4.0.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.123.0"
  }
}
