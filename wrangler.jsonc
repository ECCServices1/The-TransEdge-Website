{
  // Cloudflare Workers Static Assets.
  //
  // Cloudflare's current dashboard flow creates a Worker rather than a Pages
  // project, and a Worker needs to be told where the built site is. Without
  // this file the deploy fails with "Could not detect a directory containing
  // static files", which is accurate but unhelpful: nothing had been built and
  // nothing had been pointed at.
  //
  // This was an assets-only Worker with no "main" until the shop arrived. It
  // now has one, for a single reason: creating a Stripe Checkout Session needs
  // a secret key, and a secret key in a browser is not a secret. Everything
  // that is not /api/* still goes straight to the built files, so the site is
  // served exactly as it was. See worker/index.js.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-transedge-website",
  "compatibility_date": "2026-08-01",
  "main": "./worker/index.js",

  // Wrangler runs this before deploying, so the site is built even when the
  // dashboard's build command is left empty. Cloudflare's Workers flow arrives
  // with no build command and gives no hint that one is needed, so leaving the
  // deploy dependent on a dashboard field nobody set is how this fails twice.
  "build": {
    "command": "npm run build"
  },

  "assets": {
    // Matches the Astro build output. Changing one without the other breaks
    // the deploy.
    "directory": "./dist",

    // The Worker reaches the built site through this binding, which is how a
    // request that is not /api/* is served without the Worker having to know
    // anything about it.
    "binding": "ASSETS",

    // Unmatched routes serve the real 404 page rather than a bare Cloudflare
    // error, so a visitor who follows a dead link still gets the header, the
    // service times and a way onward.
    "not_found_handling": "404-page",

    // Assets are served before the Worker runs, so a request for a page never
    // pays for an invocation. /api/* has no asset behind it and must reach the
    // Worker rather than the 404 page, which is what this line guarantees
    // rather than leaves to the default.
    "run_worker_first": ["/api/*"]
  },

  "observability": {
    // Request logs, so a broken redirect is visible rather than guessed at.
    "enabled": true
  }
}
