---
/**
 * The basket, in the header utility row.
 *
 * Rendered only on /shop pages. Two reasons. While the shop is unpublished it
 * would advertise a range nobody can buy yet, and on every other page it would
 * be an element inserted after load once a script had read localStorage, which
 * is a layout shift on a site holding itself to a CLS budget of 0.1.
 *
 * Inside the shop the link is always present, so the script only ever changes
 * the count inside it rather than adding a control to the row. The count starts
 * empty and is filled in, which moves nothing but the width of this one item.
 */
---

<a class="basket-link" href="/shop/basket" data-basket-link>
  Basket<span class="basket-link__count" data-basket-count></span>
</a>

<script>
  import { BASKET_KEY } from '../../lib/basket-key.mjs';

  const count = document.querySelector<HTMLElement>('[data-basket-count]');
  if (count) {
    const paint = () => {
      let total = 0;
      try {
        const raw = localStorage.getItem(BASKET_KEY);
        const items = raw ? JSON.parse(raw) : [];
        if (Array.isArray(items)) {
          total = items.reduce(
            (sum: number, item: { qty?: unknown }) => sum + (Number(item?.qty) || 0),
            0
          );
        }
      } catch {
        /* A browser blocking site data is not an error worth shouting about. */
      }
      count.textContent = total > 0 ? ` (${total})` : '';
    };

    paint();
    /* Fired by AddToBasket and by the basket page, so the count is right
       without a reload. */
    window.addEventListener('tte:basket', paint);
    /* Another tab changed the basket. */
    window.addEventListener('storage', paint);
  }
</script>

<style>
  .basket-link {
    font-size: var(--text--1);
    font-weight: var(--weight-nav);
    letter-spacing: var(--tracking-wide);
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .basket-link:hover {
    text-decoration: underline;
  }

  .basket-link__count {
    font-variant-numeric: tabular-nums;
  }
</style>
