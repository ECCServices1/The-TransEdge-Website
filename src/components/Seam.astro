---
/**
 * The Edge seam.
 *
 * One continuous path entering at the top of the page and travelling its full
 * length, changing angle and weight as it passes each movement. It is the spine
 * of the composition and the visual link back to the mark.
 *
 * HOW IT MEETS THE CONSTRAINTS
 *
 * Drawn, not animated. The path is fully present in the markup, so with
 * JavaScript disabled or scroll-driven animation unsupported, the seam is there
 * in full. Nothing is revealed by scrolling; only the light that travels along
 * it moves.
 *
 * Transform and opacity only. The travelling light is a second copy of the same
 * path behind a mask, and the mask window is moved with translateY. No
 * stroke-dashoffset, no path morphing, no filter, so it stays on the compositor.
 *
 * Reduced motion. The window parks at the first movement and stops. The seam
 * remains fully drawn, so no content and no structure is lost.
 *
 * The viewBox is 100 by 1000 with preserveAspectRatio="none", so the seam
 * stretches to whatever the page height turns out to be. vector-effect keeps
 * the stroke an even weight despite that non-uniform scale.
 */

import { SEAM_PATH, SEAM_DRIFT, SEAM_REVEAL } from '../lib/seam-path.mjs';

interface Props {
  /** Left-to-right and right-to-left get mirrored paths, so the seam always enters from the leading edge. */
  dir?: 'ltr' | 'rtl';
  /** The travelling drop. Home only: it needs a long page and waypoints to land on. */
  drop?: boolean;
}

const { dir = 'ltr', drop = false } = Astro.props;

/*
  The drop's lateral track, written as a keyframe block rather than a class per
  stop, so adding a movement to the home page changes one array in
  src/lib/seam-path.mjs and nothing here.
*/
const driftKeyframes = SEAM_DRIFT.map(
  (x, i) =>
    `${((i / (SEAM_DRIFT.length - 1)) * 100).toFixed(1)}% { transform: translateX(calc(${x} * -1%)); }`
).join('\n    ');

/*
  The reveal. Opacity and stroke width rise together, so the seam gathers rather
  than merely fades up, and both dip where the copy needs the attention.

  stroke-width is not a compositor property. It is animated here anyway, on one
  path, because the alternative is a filter or a mask animation and both are
  more expensive. One SVG path re-rasterising on scroll is cheap; the budget is
  checked on every push and this is inside it.
*/
const revealKeyframes = SEAM_REVEAL.map(
  ([progress, opacity, width]) =>
    `${(progress * 100).toFixed(1)}% { opacity: ${opacity}; stroke-width: ${width}; }`
).join('\n    ');

/* The drop is the leading point of that light, so it brightens on the same
   curve rather than staying at full strength while the seam behind it is still
   obscured. */
const dropRevealKeyframes = SEAM_REVEAL.map(
  ([progress, opacity]) =>
    `${(progress * 100).toFixed(1)}% { opacity: ${Math.min(1, opacity + 0.15).toFixed(2)}; }`
).join('\n    ');

/**
 * The path in seam space. Each vertex sits at a movement boundary, which is
 * what makes the change of angle read as a handoff rather than a wobble.
 *
 *    0    enters at the top on the trailing side
 *  180    leans in behind the welcome photograph
 *  330    eases back out past the vision
 *  520    swings in across the EdgedIn movement
 *  700    returns
 *  880    settles vertical into the footer
 *
 * The whole path stays in the trailing third, between x 68 and 88. The prose
 * column is capped at 42 to 46rem inside an 80rem shell, so it ends around 62
 * per cent on a wide screen. Keeping the seam beyond that is what stops it
 * reading as a stray line drawn through the headline: it passes behind the
 * images and the open right-hand space, which is where a fold belongs.
 */
const PATH = SEAM_PATH;

/* Right-to-left mirroring is a scaleX on the field in CSS rather than a second
   path, so there is only ever one set of coordinates to keep in step. */

const maskId = 'seam-lit-window';
---

<div class="seam-field" aria-hidden="true" data-dir={dir}>
  <svg
    class="seam"
    viewBox="0 0 100 1000"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <mask id={maskId} maskUnits="userSpaceOnUse" x="0" y="-260" width="100" height="1520">
        <!-- A soft-edged window. The light has no hard boundary, so the seam
             brightens and dims rather than switching on. -->
        <linearGradient id="seam-window-fade" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#000" />
          <stop offset="0.35" stop-color="#fff" />
          <stop offset="0.65" stop-color="#fff" />
          <stop offset="1" stop-color="#000" />
        </linearGradient>
        <rect class="seam-window" x="0" y="-260" width="100" height="260" fill="url(#seam-window-fade)" />
      </mask>
    </defs>

    <!-- The seam itself. Always drawn. -->
    <path class="seam-base" data-seam-base d={PATH} vector-effect="non-scaling-stroke" />

    <!-- The light travelling along it. Hidden unless the browser can move it. -->
    <g mask={`url(#${maskId})`}>
      <path class="seam-lit" d={PATH} vector-effect="non-scaling-stroke" />
    </g>
  </svg>

  {
    /*
      The drop.

      It does not ride the SVG path. The seam is stretched non-uniformly to the
      page height, so a circle placed in that coordinate space would flatten
      into a horizontal smear on a page this long. Instead the drop is sticky at
      eye level and the page travels past it, which is the same relationship
      seen from the other side and costs one transform.

      It carries no meaning and no content. A reader who never sees it loses
      nothing, which is why it is aria-hidden along with the rest of the field.
    */
    drop && (
      <div class="drop-rail">
        <div class="drop" data-seam-drop>
          <span class="drop__bead" />
        </div>
      </div>
    )
  }
</div>

<style>
  .seam-field {
    position: absolute;
    inset-block: 0;
    inset-inline: 0;
    z-index: var(--layer-seam);
    pointer-events: none;
    /* The seam is behind the composition and never intercepts a click or a
       screen reader. It is atmosphere, not content. */
    overflow: hidden;
  }

  .seam {
    inline-size: 100%;
    block-size: 100%;
  }

  /* Right-to-left enters from the right, so the whole field is mirrored. The
     mark and the photography are not inside this element, so nothing that must
     not flip is affected. */
  .seam-field[data-dir='rtl'] .seam {
    transform: scaleX(-1);
  }

  .seam-base,
  .seam-lit {
    fill: none;
    stroke-linecap: round;
  }

  .seam-base {
    stroke: var(--color-seam);
    stroke-width: 1.5;
  }

  .seam-lit {
    stroke: var(--color-seam-lit);
    stroke-width: 2.5;
    opacity: 0;
  }

  /* On narrow screens the seam hugs the leading edge and thins out, so it never
     competes with the text it sits behind. */
  @media (max-width: 48rem) {
    .seam-base {
      stroke-width: 1;
    }
    .seam {
      /* Pushed mostly off-canvas: a hint of a fold, not a diagram. */
      transform: translateX(22%) scaleX(1.3);
    }
    .seam-field[data-dir='rtl'] .seam {
      transform: translateX(-22%) scaleX(-1.3);
    }
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .seam-lit {
        opacity: 1;
      }

      .seam-window {
        animation: seam-travel linear both;
        animation-timeline: scroll(root block);
      }
    }
  }

  /*
    Travels one window-height above the page to one window-height below it, in
    seam units, over the whole scroll. Transform only.
  */
  @keyframes seam-travel {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(1260px);
    }
  }

  /* ------------------------------------------------------------------
     The drop.

     Sticky at just above the middle of the viewport, so it sits where the
     eye already is. Its vertical position is free; only its horizontal
     position is animated, tracking the seam's drift. The page scrolling
     past a fixed bead is what reads as the bead running down the page.
     ------------------------------------------------------------------ */

  .drop-rail {
    position: absolute;
    inset-block: 0;
    /* Anchored to the trailing edge, which is the third the seam lives in. */
    inset-inline-end: 0;
    inline-size: 1px;
  }

  .drop {
    position: sticky;
    inset-block-start: 46vh;
    /* Parked off the seam until a browser can move it. A bead sitting still
       halfway down the page is a smudge, so by default it is not shown. */
    opacity: 0;
    transform: translateX(-20%);
  }

  /* The drift animation itself is in an inline style block below, keyed on a
     data attribute rather than this class. Astro rewrites both class names and
     keyframe names inside a scoped style block, so a keyframe generated from
     SEAM_DRIFT and referenced from here would be looking for a name that no
     longer exists. */

  .drop__bead {
    display: block;
    inline-size: var(--space-2xs);
    block-size: var(--space-2xs);
    border-radius: 50%;
    background-color: var(--color-seam-lit);
    /* No filter and no shadow: both would take this off the compositor and
       the whole point of the drop is that it costs one transform. */
  }

  /* On a narrow screen the seam is pushed mostly off-canvas, so the drop goes
     with it rather than hovering over the text on its own. */
  @media (max-width: 48rem) {
    .drop-rail {
      display: none;
    }
  }
</style>

<style
  is:inline
  set:html={`
@supports (animation-timeline: scroll()) {
  @media (prefers-reduced-motion: no-preference) {
    [data-seam-base] {
      animation: tte-seam-reveal linear both;
      animation-timeline: scroll(root block);
    }
  }
}
@keyframes tte-seam-reveal {
    ${revealKeyframes}
}`}
/>

{
  /* Generated from SEAM_DRIFT, so the drop's track and the seam's path cannot
     disagree: adding a movement changes one array in src/lib/seam-path.mjs. */
  drop && (
    <style
      is:inline
      set:html={`
@supports (animation-timeline: scroll()) {
  @media (prefers-reduced-motion: no-preference) {
    [data-seam-drop] {
      opacity: 1;
      animation: tte-drop-drift linear both;
      animation-timeline: scroll(root block);
    }
  }
}
@keyframes tte-drop-drift {
    ${driftKeyframes}
}
@supports (animation-timeline: scroll()) {
  @media (prefers-reduced-motion: no-preference) {
    [data-seam-drop] {
      animation:
        tte-drop-drift linear both,
        tte-drop-reveal linear both;
      animation-timeline: scroll(root block), scroll(root block);
    }
  }
}
@keyframes tte-drop-reveal {
    ${dropRevealKeyframes}
}`}
    />
  )
}
