---
/**
 * The Transformation Edge Conference 2026, tagged RAIN. The events-page card;
 * the home page stages the ConferenceChapter instead.
 *
 * The artwork arrived in August 2026, so the hosts-and-speakers social leads
 * the card and the typographic setting beneath it became what it was always
 * going to be: the caption. The typography stays in the site's own system
 * rather than imitating the poster's face, which belongs to the poster.
 *
 * No registration link, because the poster says NO REGISTRATION REQUIRED in
 * those words. The card says so too, and offers the visit page instead: the
 * venue is the church's own address, so knowing how to come is the whole task.
 */
import Button from './Button.astro';
import Photo from './Photo.astro';
import ministersArt from '../assets/photos/E1-rain-ministers.jpg';
import { CONFERENCE } from '../data/conference.mjs';

const sessionLine = CONFERENCE.sessions.map((s) => `${s.day} ${s.time}`).join(', ');

interface Props {
  /** `section` on the home canvas, `article` in a list of events. */
  as?: 'section' | 'article';
  headingId?: string;
  headingLevel?: 2 | 3;
}

const { as: Tag = 'section', headingId = 'conference-heading', headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<Tag class="rain" aria-labelledby={headingId}>
  <div class="rain__weather" aria-hidden="true">
    <span class="rain__shaft"></span>
  </div>

  <div class="rain__inner">
    <p class="rain__eyebrow" data-reveal>This November</p>

    <Heading id={headingId} class="rain__teaser" data-reveal>
      {CONFERENCE.teaser}
    </Heading>

    <Photo
      ref="E1"
      src={ministersArt}
      alt={`The RAIN 2026 hosts and speakers artwork: the Senior Pastors mid-ministry under storm clouds, with additional ministers ${CONFERENCE.ministers.join(' and ')}.`}
      brief="The conference artwork, hosts and speakers."
      ratio="1672 / 941"
      sizes="(min-width: 56rem) 38rem, 100vw"
      class="rain__art"
    />

    <p class="rain__name" data-reveal>
      {CONFERENCE.name}
      <span class="rain__tag">{CONFERENCE.tag}</span>
    </p>

    <p class="rain__dates" data-reveal>
      <time datetime={CONFERENCE.startsAt} class="ltr-embed">{CONFERENCE.displayDates}</time>
    </p>

    <p class="rain__facts" data-reveal>
      {sessionLine}. Open-air crusade, {CONFERENCE.crusade.day}, {CONFERENCE.crusade.time}.
      <br />
      {CONFERENCE.venue}.
    </p>

    <p class="rain__actions" data-reveal>
      {
        CONFERENCE.registrationUrl ? (
          <Button href={CONFERENCE.registrationUrl} size="large" external>
            Register
          </Button>
        ) : (
          <>
            <span class="rain__open">No registration required. The doors are open.</span>
            <Button href="/new-here/plan-your-visit" tone="quiet">Plan your visit</Button>
          </>
        )
      }
    </p>
  </div>
</Tag>

<style>
  .rain {
    position: relative;
    overflow: hidden;
    padding: var(--space-3xl) var(--space-l);
    background-color: var(--color-canvas-inverse);
    color: var(--color-text-inverse);
    border-radius: var(--radius-l);
    isolation: isolate;
  }

  /* The shaft of light, drawn rather than photographed. Two gradients: a wide
     soft bloom, and a narrow column reaching down to the base. It is the same
     figure as the poster and none of the poster's pixels. */
  .rain__weather {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      radial-gradient(
        60% 55% at 72% 0%,
        color-mix(in oklab, var(--color-ember) 34%, transparent),
        transparent 70%
      ),
      radial-gradient(
        90% 70% at 20% 100%,
        color-mix(in oklab, var(--color-heritage) 40%, transparent),
        transparent 72%
      );
  }

  .rain__shaft {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 22%;
    inline-size: clamp(2px, 0.6vw, 6px);
    background: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--color-ember-light) 85%, transparent),
      color-mix(in oklab, var(--color-ember-light) 25%, transparent) 62%,
      transparent
    );
  }

  .rain__inner {
    position: relative;
    max-inline-size: 40rem;
  }

  .rain__eyebrow {
    font-size: var(--text--1);
    font-weight: var(--weight-semibold);
    /* Was --tracking-widest, which no token defines, so it silently resolved
       to normal. The defined wide step is what was meant. */
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    /* Full strength rather than dimmed. This sits on the inverse ground, which
       is a checked pairing; an opacity on top of it is not. */
    color: var(--color-text-inverse);
  }

  .rain__teaser {
    margin-block: var(--space-s) var(--space-m);
    font-family: var(--font-display);
    font-size: var(--text-4);
    line-height: var(--leading-tight);
    letter-spacing: var(--text-4-tracking);
    text-wrap: balance;
  }

  .rain__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-s);
    font-size: var(--text-1);
  }

  .rain__tag {
    padding: var(--space-3xs) var(--space-2xs);
    font-size: var(--text--1);
    font-weight: var(--weight-semibold);
    /* Was --tracking-widest, which no token defines, so it silently resolved
       to normal. The defined wide step is what was meant. */
    letter-spacing: var(--tracking-wide);
    /* An outline rather than a fill. Ember is capped at five per cent of a
       composition and the shaft has already spent most of it. */
    border: var(--border-hairline) solid currentColor;
    border-radius: var(--radius-s);
  }

  .rain__dates {
    margin-block-start: var(--space-s);
    font-family: var(--font-display);
    font-size: var(--text-2);
  }

  .rain__art {
    margin-block: var(--space-l);
  }

  .rain__facts {
    margin-block-start: var(--space-s);
    max-inline-size: var(--measure);
    line-height: var(--leading-normal);
  }

  .rain__actions {
    margin-block-start: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-m);
  }

  .rain__open {
    font-weight: var(--weight-semibold);
  }

  /* The quiet button's default ink is tuned for the light canvas and sinks
     into this ground. Axe cannot compute contrast over the gradient weather,
     so this pairing is asserted here rather than left to the sweep. */
  .rain__actions :global(.btn--quiet) {
    color: var(--color-text-inverse);
    border-color: var(--color-neutral-400);
  }

  @media (max-width: 48rem) {
    .rain {
      padding: var(--space-2xl) var(--space-m);
    }

    /* The shaft moves off the type on a narrow screen rather than falling
       across it. */
    .rain__shaft {
      inset-inline-end: 8%;
    }
  }
</style>
