---
/**
 * What every website form needs besides its own fields: which form it is, a
 * honeypot, and the Turnstile spam check.
 *
 * One component, because the three forms grew separately and only one of them
 * ever loaded Turnstile's script: the prayer form and the Life-Link finder
 * rendered an empty widget that could never produce a token, so neither could
 * have been sent even once the Worker existed. Shared plumbing is plumbing
 * that cannot drift that way again.
 *
 * Turnstile's script loads only when a form scrolls near the screen, so a
 * visitor who reads the page and leaves never contacts Cloudflare's challenge
 * service at all. Expired tokens refresh themselves, so somebody who takes
 * twenty minutes over a prayer request is not refused for taking care.
 *
 * The honeypot is a field no person sees. Bots fill every field they find; the
 * Worker quietly discards anything with this one filled.
 */
import { TURNSTILE_SITE_KEY } from '../data/forms.mjs';

interface Props {
  /** Must match a key in FORMS in src/data/forms.mjs. */
  form: 'contact' | 'life-link' | 'prayer';
}

const { form } = Astro.props;
---

<input type="hidden" name="form" value={form} />

<div hidden>
  <label>
    Leave this empty
    <input type="text" name="website" autocomplete="off" />
  </label>
</div>

<div
  class="cf-turnstile"
  data-sitekey={TURNSTILE_SITE_KEY}
  data-theme="auto"
  data-refresh-expired="auto"
>
</div>

<script>
  /* Bundled once per page, however many forms the page carries. */
  const widgets = document.querySelectorAll('.cf-turnstile');
  if (widgets.length) {
    let requested = false;
    const load = () => {
      if (requested) return;
      requested = true;
      const script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
      script.async = true;
      script.defer = true;
      document.head.append(script);
    };
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        load();
      },
      { rootMargin: '300px' }
    );
    widgets.forEach((widget) => observer.observe(widget));
  }
</script>
