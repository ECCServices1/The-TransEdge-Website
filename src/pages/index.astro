---
/**
 * Home: the continuous canvas.
 *
 * Twelve movements, each opening into the next. The handoff device for every
 * boundary is named in a comment above the movement and drawn in
 * docs/home-scroll-storyboard.md.
 *
 * The order runs arrival, welcome, vision, the conference, events, outreach,
 * EdgedIn, watch and listen, give, life at TTE, connect, and finishes at get in
 * touch. That last
 * one matters: every movement above it asks the reader to do something, and the
 * page ends by offering a person to talk to instead.
 *
 * TWO KINDS OF MOVEMENT. Most movements flow: they scroll past like a page.
 * Two of them are chapters: full-viewport dark stages that pin while the page
 * scrolls, so the scroll is spent on a transformation in place rather than on
 * travel. Arrival is the first, and the conference is the second. The page
 * opens before dawn; scrolling opens the light, the hero yields to the
 * sentence that carries into the welcome, and the porcelain canvas arrives as
 * the dark lifts. The conference chapter returns to that darkness mid-page and
 * fills it with the light the artwork promises. Dark, light, dark, light: the
 * staging is the reveal figure at page scale, and it is why the seam's
 * brightness curve peaks where the second chapter exits.
 *
 * Chapters obey the same motion law as everything else here: CSS scroll-driven
 * animation only, transform and opacity only, and the resting state is the
 * arrived state. Without support, or with motion reduced, each chapter is one
 * dark viewport of ordinary flow with everything visible, and the page loses
 * nothing but the journey.
 *
 * Several movements are joined by a sentence that starts in one and finishes as
 * the heading of the next, so the page reads as one statement rather than a
 * stack of panels. The drop on the seam carries the same idea visually: it
 * lands on each movement's waypoint, which lights and reaches towards the next.
 *
 * Above the fold: who, where, when, one primary action, all visible at scroll
 * zero. No carousel, no autoplay, no modal on load. The pin only decides what
 * the first hundred and twenty viewport-heights of scrolling are for.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Photo from '../components/Photo.astro';
import EdgeMark from '../components/EdgeMark.astro';
import Waypoint from '../components/Waypoint.astro';
import ConferenceChapter from '../components/ConferenceChapter.astro';

import { CHURCH, VISION, TAGLINE, FAMILY_ORGS, GIVING } from '../data/church.mjs';
import { gatheringSchema } from '../lib/structured-data.mjs';
import { getUpcomingEvents } from '../lib/connect.mjs';
import { nextOccurrence } from '../lib/dates.mjs';

const sunday = CHURCH.gatherings.find((g) => g.key === 'sunday')!;
const midweek = CHURCH.gatherings.find((g) => g.key === 'midweek')!;

/*
  The locked vision, split at its own commas so each clause can rise into view
  in turn. The clauses are derived from the constant, never retyped, and the
  build fails if they no longer reassemble into the locked text byte for byte.
*/
const visionClauses = VISION.split(/(?<=,)\s+/);
if (visionClauses.join(' ') !== VISION) {
  throw new Error('Vision clause split no longer reassembles the locked text.');
}

const events = (await getUpcomingEvents()).slice(0, 3);

const schema = CHURCH.gatherings.map((g) => gatheringSchema(g, nextOccurrence(g.isoDay)));

const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(CHURCH.address.full)}`;
---

<BaseLayout
  title={CHURCH.name}
  description="A church in Penrith, Sydney, with a vision that reaches nations. We gather Sundays at 9:30am. Everyone is welcome, and nobody is singled out."
  route=""
  schema={schema}
  bare
  seamDrop
>
  <!-- ==================================================================
       MOVEMENT 1: ARRIVAL. The first chapter.
       Who, where, when, one action, all above the fold at scroll zero, on
       a pre-dawn ground. Scrolling scrubs the dawn open behind the type;
       the hero recedes the way a headline yields to the thing it announced;
       and the handoff sentence blooms in its place before the pin releases
       into the light canvas.
       Handoff out: the sentence "There is a place for you here" begins in
       this chapter, in the dark, and its second half opens movement 2 in
       the light. The grammar crosses the ground change, which is the point.
       No data-reveal here: the chapter choreographs its own children, and
       the fold must be complete at first paint for LCP.
       ================================================================== -->
  <section class="movement arrival" aria-labelledby="arrival-heading">
    <Waypoint step={1} />
    <div class="arrival__stage">
      <div class="arrival__dawn" aria-hidden="true"></div>

      <div class="page-shell page-shell--wide arrival__inner">
        <p class="arrival__eyebrow">{CHURCH.place}</p>

        <!-- Supplied hero copy, verbatim from the typography handover. Two
             sentences, sentence case, with the accent on the final word only.
             Block spans rather than a br: hiding a br on narrow screens
             swallowed the space between the sentences, and "Penrith.A vision"
             rendered joined. The space between the spans is explicit, so
             inline reflow keeps it. -->
        <h1 id="arrival-heading" class="arrival__heading">
          <span class="arrival__sentence">A church in Penrith.</span>{' '}
          <span class="arrival__sentence">A vision to impact <em>nations.</em></span>
        </h1>

        <dl class="arrival__facts">
          <div>
            <dt>Sundays</dt>
            <dd class="ltr-embed">{sunday.time}</dd>
          </div>
          <div>
            <dt>Wednesdays</dt>
            <dd class="ltr-embed">{midweek.time}</dd>
          </div>
          <div>
            <dt>Where</dt>
            <dd>
              <a href={mapHref} rel="noopener">
                {CHURCH.address.street}, {CHURCH.address.suburb}
              </a>
            </dd>
          </div>
        </dl>

        <!-- One primary action. Nothing competes with it in this movement. -->
        <div class="arrival__action">
          <Button href="/new-here/plan-your-visit" size="large">Plan your visit</Button>
          <p class="arrival__reassurance">
            About an hour and three quarters. Your children are cared for. You will not be
            singled out or asked to give.
          </p>
        </div>
      </div>

      <div class="page-shell page-shell--wide">
        <p class="arrival__handoff">There is a place for you here,</p>
      </div>
    </div>
  </section>

  <!-- ==================================================================
       MOVEMENT 2: WELCOME
       Completes the sentence opened above. The photograph is cropped by the
       viewport edge and sits half in this movement and half in the next.
       Handoff out: the photograph continues past the boundary.
       ================================================================== -->
  <section class="movement welcome" aria-labelledby="welcome-heading">
    <Waypoint step={2} />
    <div class="page-shell page-shell--wide welcome__inner">
      <div class="welcome__copy">
        <h2 id="welcome-heading" class="welcome__heading" data-reveal>
          and you do not have to arrive as anyone but yourself.
        </h2>
        <div class="prose" data-reveal>
          <p>
            We are a congregation of many languages and many countries, in one room, on a
            Sunday morning in Western Sydney. People here lead, teach, cook, play, build and
            welcome. That is what the room is made of.
          </p>
          <p>
            If it is your first time, the welcome desk is just inside the main entrance. Tell
            them it is your first Sunday and someone will walk you in.
          </p>
        </div>
        <p data-reveal>
          <Button href="/new-here/what-to-expect" tone="quiet">What a Sunday looks like</Button>
        </p>
      </div>

      <!-- Landscape, and full width beneath the copy rather than in a narrow
           column. A wide shot of a full room is the single most useful
           photograph on this site, and squeezing it into a portrait slot beside
           the text throws away the room, which is the whole subject. -->
      <Photo
        ref="S1"
        brief="Wide, from the back of the room, mid-gathering. Faces visible, no single hero, no empty seats. Room at top right for the seam to cross."
        ratio="16 / 9"
        bleed="inline-end"
        class="welcome__photo"
      />
    </div>
  </section>

  <!-- ==================================================================
       MOVEMENT 3: VISION
       The locked vision, set large, unveiled a clause at a time: each one
       rises out of a clipped row as the scroll reaches it, so the words
       are read at the pace they were written. The text itself is derived
       from the locked constant and asserted byte-identical at build.
       Handoff out: the seam changes colour here, and that colour resolves
       into the accent used by the next movement's action.
       ================================================================== -->
  <section class="movement vision" aria-labelledby="vision-heading">
    <Waypoint step={3} />
    <div class="page-shell vision__inner">
      <h2 id="vision-heading" class="vision__label" data-reveal>Our vision</h2>
      <blockquote class="vision__quote">
        <p>
          {
            visionClauses.map((clause) => (
              <span class="vision__mask"><span class="vision__line">{clause}</span></span>
            ))
          }
        </p>
      </blockquote>
      <p class="vision__tagline" data-reveal>{TAGLINE}</p>
      <p data-reveal>
        <Button href="/who-we-are" tone="plain">Who we are</Button>
      </p>
    </div>
  </section>

  <!-- ==================================================================
       MOVEMENT 4: THE CONFERENCE. The second chapter.
       The next major event, and the darkest thing on the page: a full-bleed
       pinned stage where the scroll performs the unveiling the artwork
       promises. The whole canvas is light opening out of obscurity, and this
       is where that stops being a metaphor. The stage covers the seam while
       it holds; the seam's reveal curve peaks just past its exit, carrying
       the chapter's light back onto the canvas.
       Handoff out: the weather clears and the diary follows.
       ================================================================== -->
  <section class="movement conference" aria-labelledby="conference-heading">
    <Waypoint step={4} />
    <ConferenceChapter />
  </section>

  <!-- ==================================================================
       MOVEMENT 5: THIS WEEK
       Events from Connect. Falls back to the last successful payload, and
       to the standing gatherings if there is nothing at all, so this
       movement is never empty.
       Handoff out: the last card's trailing edge aligns with the opening
       rule of the EdgedIn movement.
       ================================================================== -->
  <section class="movement week" aria-labelledby="week-heading">
    <Waypoint step={5} />
    <div class="page-shell page-shell--wide">
      <div class="week__head">
        <h2 id="week-heading" data-reveal>What is on</h2>
        <p data-reveal><Button href="/events" tone="plain">All events</Button></p>
      </div>

      {
        events.length > 0 ? (
          <ul class="week__list" role="list">
            {events.map((event) => (
              <li class="week__card" data-reveal>
                <p class="week__when">
                  <time datetime={event.startsAt} class="ltr-embed">
                    {event.displayDate}
                  </time>
                </p>
                <h3 class="week__title">
                  <a href={`/events/${event.slug}`}>{event.title}</a>
                </h3>
                <p class="week__summary">{event.summary}</p>
              </li>
            ))}
          </ul>
        ) : (
          <ul class="week__list" role="list">
            {CHURCH.gatherings.map((g) => (
              <li class="week__card" data-reveal>
                <p class="week__when">Every {g.day}</p>
                <h3 class="week__title">{g.day} gathering</h3>
                <p class="week__summary ltr-embed">{g.time}</p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>


  <!-- ==================================================================
       MOVEMENT 6: OUTREACH
       ECCS as sister organisation. Careful wording: separate entity,
       services are not church programs, no church involvement required.
       Handoff out: the closing line opens the Connect movement.
       ================================================================== -->
  <section class="movement outreach" aria-labelledby="outreach-heading">
    <Waypoint step={6} />
    <div class="page-shell outreach__inner">
      <h2 id="outreach-heading" data-reveal>Beyond the room</h2>
      <div class="prose" data-reveal>
        <p>
          {FAMILY_ORGS.eccs.name} is our sister organisation and community outreach arm. It is a
          separate entity with its own team, and its services are open to anyone in the
          community. You do not need to be part of our church, or any church, to use them.
        </p>
      </div>
      <p data-reveal>
        <Button href="/outreach" tone="quiet">About our outreach</Button>
      </p>
    </div>
  </section>
  <!-- ==================================================================
       MOVEMENT 7: EDGEDIN
       The most editorially expressive area. Inverted ground, so the seam
       reads as light rather than line while it crosses.
       Handoff out: the inverted ground resolves back to canvas through a
       gradient that starts inside this movement and finishes in the next.
       ================================================================== -->
  <section class="movement edgedin" aria-labelledby="edgedin-heading">
    <Waypoint step={7} />
    <div class="page-shell page-shell--wide edgedin__inner">
      <div>
        <p class="edgedin__eyebrow" data-reveal>EdgedIn Network</p>
        <h2 id="edgedin-heading" class="edgedin__heading" data-reveal>
          Teaching, conversation and writing that travels further than a Sunday.
        </h2>
        <p class="edgedin__body" data-reveal>
          The podcast, the channel, the radio hour, the devotionals and the books. Listen on
          the way to work, or read one page before bed.
        </p>
        <p data-reveal>
          <Button href="/edgedin" tone="quiet">Open EdgedIn</Button>
        </p>
      </div>

      <Photo
        ref="S2"
        brief="Recording setup mid-session, hands and microphone, shallow depth. Portrait or square. Warm key light."
        ratio="1 / 1"
        class="edgedin__photo"
      />
    </div>
  </section>

  <!-- ==================================================================
       MOVEMENT 8: WATCH AND LISTEN
       The first movement a returning visitor is looking for. Inverted
       ground again, briefly, so the drop reads as light crossing it.
       Handoff out: "take it with you" opens the giving movement, which is
       the other thing people do between Sundays.
       ================================================================== -->
  <section class="movement listen" aria-labelledby="listen-heading">
    <Waypoint step={8} />
    <div class="page-shell listen__inner">
      <h2 id="listen-heading" data-reveal>Missed a Sunday, or want it again</h2>
      <div class="prose" data-reveal>
        <p>
          Every message is there to listen back to, and the gathering is streamed live if you
          cannot be in the room. Put it on in the car, or in the kitchen, or at two in the
          morning when the house is finally quiet.
        </p>
      </div>
      <p class="movement__actions" data-reveal>
        <Button href="/watch-and-listen">Watch and listen</Button>
        <Button href={`${CHURCH.connectUrl}/live`} tone="quiet" external>Watch live</Button>
      </p>
      <p class="movement__handoff" data-reveal>What happens on a Sunday costs something to make,</p>
    </div>
  </section>

  <!-- ==================================================================
       MOVEMENT 9: GIVE
       Completes the sentence opened above. Trust markers, not marketing:
       no urgency, no guilt, no countdown, and the deductibility line is
       stated rather than left for someone to assume.
       Handoff out: "and none of it runs itself" opens Life at TTE.
       ================================================================== -->
  <section class="movement give" aria-labelledby="give-heading">
    <Waypoint step={9} />
    <div class="page-shell give__inner">
      <h2 id="give-heading" data-reveal>and giving is how most of it is paid for.</h2>
      <div class="prose" data-reveal>
        <p>
          Bank transfer or card, whichever suits. No fees come out of a transfer, so the full
          amount reaches our church. Giving to our church is not tax deductible, and we will
          not issue a receipt that suggests otherwise.
        </p>
      </div>
      <p class="movement__actions" data-reveal>
        <Button href="/give">Ways to give</Button>
        <Button href={GIVING.card.href} tone="quiet" external>Give in Connect</Button>
      </p>
      <p class="movement__handoff" data-reveal>None of it runs itself,</p>
    </div>
  </section>

  <!-- ==================================================================
       MOVEMENT 10: LIFE AT TTE
       Completes the sentence again. The people who do the work are the
       congregation, which is the point rather than a flourish.
       Handoff out: the mark appears, and the Connect movement follows.
       ================================================================== -->
  <section class="movement life" aria-labelledby="life-heading">
    <Waypoint step={10} />
    <div class="page-shell life__inner">
      <h2 id="life-heading" data-reveal>and the people who do it come on a Sunday.</h2>
      <div class="prose" data-reveal>
        <p>
          Welcome, music, sound, children's work, coffee, setting up and packing down. Groups
          through the week, and teams that keep a Sunday running. Most people here started by
          being asked once and saying yes.
        </p>
      </div>
      <p class="movement__actions" data-reveal>
        <Button href="/life-at-tte">Life at TTE</Button>
        <Button href="/new-here/edgekids" tone="quiet">EdgeKids</Button>
      </p>
    </div>
  </section>


  <!-- ==================================================================
       MOVEMENT 11: CONNECT
       The handoff out of the marketing site. Same tokens, same symbol, so
       leaving does not feel like leaving.
       Handoff out: the seam settles vertical and runs into the footer.
       ================================================================== -->
  <section class="movement connect" aria-labelledby="connect-heading">
    <Waypoint step={11} />
    <div class="page-shell connect__inner">
      <EdgeMark size={44} />
      <h2 id="connect-heading" data-reveal>Already part of our church?</h2>
      <p data-reveal>Rosters, groups, giving and your details are all in Connect.</p>
      <p data-reveal>
        <Button
          href={CHURCH.connectUrl}
          external
          data-connect-label
          data-connect-label-signed-in="Open Connect">Sign in to Connect</Button
        >
      </p>
    </div>
  </section>

  <!-- ==================================================================
       MOVEMENT 12: GET IN TOUCH
       The last movement, and the only one that asks nothing. Everything
       above offers something to do; this offers a person to talk to.
       The drop stops here: the chain ends rather than fading out.
       ================================================================== -->
  <section class="movement reach" aria-labelledby="reach-heading">
    <Waypoint step={12} last />
    <div class="page-shell reach__inner">
      <h2 id="reach-heading" data-reveal>If you would rather just ask someone</h2>
      <div class="prose" data-reveal>
        <p>
          Call, email, or ask for prayer privately. A person reads everything that comes in
          and replies within two working days. You do not have to be coming on Sunday, and
          you do not have to explain why you are writing.
        </p>
      </div>
      <p class="movement__actions" data-reveal>
        <Button href="/get-in-touch" size="large">Get in touch</Button>
        <Button href="/get-in-touch/prayer" tone="quiet">Ask for prayer</Button>
      </p>
      <p class="reach__direct" data-reveal>
        <a href={`tel:${CHURCH.phoneE164}`} class="ltr-embed">{CHURCH.phone}</a>
        <a href={`mailto:${CHURCH.email}`}>{CHURCH.email}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ------------------------------------------------------------------
     Rhythm. Density and height vary on purpose. The silence between
     movements is part of the composition, so these values are not equal
     and are not meant to be.
     ------------------------------------------------------------------ */

  .movement {
    position: relative;
  }

  /*
    The reveals on this page track the scroll for longer than the site-wide
    default. Elsewhere a reveal is a settle: it finishes early so a reader
    who is skimming never waits for the page. Here the page is one
    composition and the scroll is the instrument, so the same 12px settle is
    stretched across a third of the element's travel and reads as scrubbed
    rather than triggered. Only the range changes; the keyframes, the
    reduced-motion policy and the no-support fallback are the site's own.
  */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .movement :global([data-reveal]) {
        animation-range: entry 12% cover 45%;
      }
    }
  }

  /* ------------------------------------------------------------------
     Arrival: the first chapter.

     The resting state below is the whole design for browsers that cannot
     scrub it: one pre-dawn viewport of ordinary flow with everything
     visible, the handoff line included. The scrub, further down, is the
     only place the track grows tall and the stage pins.
     ------------------------------------------------------------------ */

  .arrival {
    padding-block: 0;
  }

  .arrival__stage {
    position: relative;
    overflow: clip;
    min-block-size: 100svb;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* Sticky-header clearance: the stage owns the top of the page and the
       type must start below the bar, not under it. */
    padding-block: calc(var(--header-height, 4rem) + var(--space-xl)) var(--space-2xl);
    /* Pre-dawn: the deepest neutral easing towards the brand slate at the
       foot, so the exit into the light canvas is a chapter cut, not a cliff
       from pure black. */
    background-color: var(--color-neutral-950);
    background-image: linear-gradient(
      to bottom,
      var(--color-neutral-950) 0%,
      var(--color-neutral-950) 58%,
      var(--color-primary) 100%
    );
    color: var(--color-text-inverse);
  }

  /* The dawn. A field of warmth behind the trailing side of the type,
     opening as the page is scrolled. At rest it is simply there, at full;
     under the scrub it starts closed and opens. */
  .arrival__dawn {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(
        52% 58% at 74% 24%,
        color-mix(in oklab, var(--color-ember) 26%, transparent),
        transparent 70%
      ),
      radial-gradient(
        80% 60% at 20% 96%,
        color-mix(in oklab, var(--color-heritage) 36%, transparent),
        transparent 72%
      );
    transform-origin: 74% 24%;
  }

  .arrival__inner {
    position: relative;
    inline-size: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .arrival__eyebrow {
    font-size: var(--text--1);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-neutral-400);
  }

  .arrival__heading {
    /* The line breaks are authored, so no ch cap is needed and none is set. */
    max-inline-size: 100%;
    font-family: var(--font-display);
    font-size: var(--text-5);
    font-weight: var(--weight-semibold);
    line-height: var(--text-5-leading);
    letter-spacing: var(--text-5-tracking);
    /* The largest setting on the site gets the display cut and a touch of the
       SOFT axis, which is the one place Fraunces is allowed its full character. */
    font-variation-settings: 'SOFT' 30, 'WONK' 0, 'opsz' 144;
    /* The copy is two authored sentences. Balancing would re-break them. */
    text-wrap: nowrap;
    overflow-wrap: break-word;
  }

  /* One sentence per line on wide screens: the authored break. */
  .arrival__sentence {
    display: block;
  }

  /*
    The accent, on the final word only. The handover caps the accent at roughly
    ten per cent of a typographic composition, and one word of two lines is
    about eight. On this dark stage it is the light cut of ember, the token
    that exists for exactly this ground; the accessible cut is tuned for
    porcelain and reads as rust here.
  */
  .arrival__heading em {
    font-style: normal;
    color: var(--color-ember-light);
  }

  /* On narrow screens the authored breaks are dropped so the two sentences can
     reflow rather than overflow. Inline, with the explicit space between the
     spans doing the joining. */
  @media (max-width: 45rem) {
    .arrival__sentence {
      display: inline;
    }
    .arrival__heading {
      text-wrap: balance;
    }
  }

  .arrival__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m) var(--space-xl);
    margin-block-start: var(--space-s);
  }

  .arrival__facts dt {
    font-size: var(--text--1);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-neutral-400);
  }

  .arrival__facts dd {
    margin: 0;
    font-size: var(--text-2);
    font-family: var(--font-display);
  }

  /* The map link keeps its underline for affordance and takes the stage's
     ink: the accent link colour is tuned for porcelain, not for this ground. */
  .arrival__facts a {
    color: inherit;
  }

  .arrival__action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    margin-block-start: var(--space-s);
  }

  .arrival__reassurance {
    max-inline-size: min(46ch, 100%);
    color: var(--color-neutral-300);
    /* Body size, not micro. This answers "will I be singled out" and "what
       happens to my children", which is not a supporting label. */
    font-size: var(--text-0);
  }

  /* The primary action restated in the stage's own light: a slate button
     sinks into a slate ground. These are the dark-scheme action tokens, so
     the button is identical in both schemes here. */
  .arrival__action :global(.btn--primary) {
    background-color: var(--color-neutral-100);
    color: var(--color-neutral-900);
  }

  .arrival__action :global(.btn--primary:hover) {
    background-color: var(--color-white);
  }

  /* The handoff. Reads as an unfinished sentence, because it is one. Under
     the scrub it blooms as the hero recedes; at rest it simply closes the
     chapter. */
  .arrival__handoff {
    margin-block-start: var(--space-2xl);
