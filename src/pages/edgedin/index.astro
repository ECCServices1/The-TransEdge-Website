---
/**
 * EdgedIn Network hub, section 14.
 *
 * The most editorially expressive area of the site, still inside the family.
 * Episodes come from Connect and are never duplicated into this repository;
 * the places the network already lives (the podcast platforms, the channel,
 * the radio stream, the socials) come from src/data/edgedin.mjs, supplied by
 * the client in September 2026.
 *
 * Phase 2 adds the persistent player, episode pages with transcripts and
 * chapters, and the publishing strand. This is the launch hub: the strands,
 * each with where to find it, and the latest release playable without a page
 * reload once Connect publishes one.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/Button.astro';
import { getEdgedInAssets } from '../../lib/connect.mjs';
import { EDGEDIN } from '../../data/edgedin.mjs';

const assets = await getEdgedInAssets();
const latest = assets[0] ?? null;

/* Each strand says where it lives. A strand with nowhere to go yet says so
   in one word rather than apologising. */
const strands = [
  {
    key: 'podcast',
    name: 'Podcast',
    body: 'Conversation and teaching with Ps Michaels, wherever you listen.',
    links: EDGEDIN.podcast.platforms,
  },
  {
    key: 'youtube',
    name: 'Channel',
    body: 'Messages and short films.',
    links: [{ name: 'Watch on YouTube', href: EDGEDIN.youtube.href }],
  },
  {
    key: 'radio',
    name: EDGEDIN.radio.name,
    body: 'Live, around the clock. Press play.',
    stream: EDGEDIN.radio.stream,
  },
  { key: 'devotional', name: 'Devotionals', body: 'One page, most mornings.' },
  { key: 'publishing', name: 'Publishing', body: 'Books and study material from this house.' },
];
---

<PageLayout
  title="EdgedIn Network"
  description="The media and publishing arm of The Transformation Edge: podcast, channel, radio, devotionals and publishing."
  route="edgedin"
  standfirst="Teaching, conversation and writing that travels further than a Sunday."
>
  {
    latest && (
      <section class="latest" aria-labelledby="latest-heading">
        <p class="latest__eyebrow">Latest release</p>
        <h2 id="latest-heading" class="latest__title">{latest.title}</h2>
        {latest.summary && <p class="latest__summary">{latest.summary}</p>}
        {latest.audioUrl && (
          <audio class="latest__player" controls preload="none" src={latest.audioUrl}>
            Your browser cannot play audio. <a href={latest.audioUrl}>Download the episode</a> instead.
          </audio>
        )}
      </section>
    )
  }

  <section class="strands" aria-labelledby="strands-heading">
    <h2 id="strands-heading">The strands</h2>
    <ul role="list">
      {
        strands.map((strand) => {
          const count = assets.filter((a) => a.strand === strand.key).length;
          const live = Boolean(strand.links || strand.stream);
          return (
            <li data-reveal>
              <h3>{strand.name}</h3>
              <p>{strand.body}</p>
              {strand.links && (
                <p class="strands__links">
                  {strand.links.map((link) => (
                    <Button href={link.href} tone="quiet" external>
                      {link.name}
                    </Button>
                  ))}
                </p>
              )}
              {strand.stream && (
                <audio
                  class="strands__player"
                  controls
                  preload="none"
                  src={strand.stream}
                  aria-label={`${strand.name} live stream`}
                >
                  Your browser cannot play the stream. <a href={strand.stream}>Open it directly</a> instead.
                </audio>
              )}
              {count > 0 ? (
                <p class="strands__count">{count} published</p>
              ) : (
                !live && <p class="strands__count">Coming</p>
              )}
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="follow" aria-labelledby="follow-heading">
    <h2 id="follow-heading">Follow along</h2>
    <p class="follow__links">
      {
        EDGEDIN.socials.map((social) => (
          <Button href={social.href} tone="quiet" external>
            {social.name}
          </Button>
        ))
      }
    </p>
  </section>

  <p><Button href="/watch-and-listen" tone="quiet">Sunday messages</Button></p>
</PageLayout>

<style>
  .latest {
    padding: var(--space-l);
    margin-block-end: var(--space-2xl);
    max-inline-size: 46rem;
    background-color: var(--color-canvas-inverse);
    color: var(--color-text-inverse);
    border-radius: var(--radius-l);
  }

  .latest__eyebrow {
    font-size: var(--text--1);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    opacity: 0.75;
  }

  .latest__title {
    margin-block: var(--space-2xs) var(--space-s);
    font-size: var(--text-3);
  }

  .latest__summary {
    max-inline-size: var(--measure);
    opacity: 0.85;
  }

  .latest__player {
    inline-size: 100%;
    margin-block-start: var(--space-m);
  }

  .strands h2,
  .follow h2 {
    font-size: var(--text-2);
  }

  .strands ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-l);
    margin: var(--space-m) 0 var(--space-2xl);
    padding: 0;
    list-style: none;
  }

  .strands li {
    padding-block-start: var(--space-s);
    border-block-start: var(--border-thick) solid var(--color-border-strong);
  }

  .strands h3 {
    font-size: var(--text-1);
    margin-block-end: var(--space-3xs);
  }

  .strands p {
    color: var(--color-text-muted);
  }

  .strands__links,
  .follow__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-s);
  }

  .strands__player {
    display: block;
    inline-size: 100%;
    margin-block-start: var(--space-s);
  }

  .strands__count {
    margin-block-start: var(--space-2xs);
    font-size: var(--text--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .follow {
    margin-block-end: var(--space-2xl);
  }
</style>
