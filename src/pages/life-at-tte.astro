---
/**
 * Life at TTE, section 9. A main navigation item that was 404ing on every page
 * of the site.
 *
 * Section 7 names Life-Link, Champions, EdgeKids and CORE Course as ministries
 * and endorsed sub-brands, and section 9 adds serve teams and 1B2GaS.
 *
 * Life-Link and Champions are the client's copy, supplied in September 2026 and
 * given a section each below because both carry more than an index line can
 * hold. EdgeKids and the CORE Course have their own pages and are linked rather
 * than repeated. 1B2GaS is still a name with nothing behind it, which is why
 * this page stays out of the index: an index entry reading "description to
 * come" is honest on a page a visitor was sent to, and dishonest in a search
 * result.
 *
 * CHAMPIONS AND THE GIVING RULES
 *
 * Champions is a giving commitment, so section 13 governs it: no urgency, no
 * guilt, no implication that a gift to our church is tax deductible, because
 * it is not. The section describes what the giving pays for and routes to the
 * Give page, which carries the receipting position in full.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/Button.astro';
import DraftNotice from '../components/DraftNotice.astro';
import Photo from '../components/Photo.astro';
import serving from '../assets/photos/S8-serving.jpg';
import { CHURCH } from '../data/church.mjs';

/*
  `href` only where a page exists. Everything else carries no link, because a
  link to nothing is worse than a name with no link: one of them tells the truth
  about how much is ready.
*/
const ministries = [
  {
    name: 'EdgeKids',
    href: '/new-here/edgekids',
    body: 'Children during the Sunday gathering, with screened and trained leaders.',
  },
  {
    name: 'ReloVance',
    body: 'Relationships in every form: marriage, singleness, dating, parenting and family. Convened by Pastor Osas Aibangbee.',
  },
  {
    name: 'Life-Link',
    href: '#life-link',
    body: 'The Transformation Edge in your neighbourhood: groups that meet where people already live.',
  },
  {
    name: 'Champions',
    href: '#champions',
    body: 'The League of Champions, our Kingdom Building Partners, who give consistently to three areas of the work.',
  },
  {
    name: 'CORE Course',
    href: '/who-we-are/core-course',
    body: 'Where people start when they want to understand what we hold to.',
  },
  {
    name: '1B2GaS',
    body: 'Description to come.',
  },
];

/* The three areas Champions giving supports, in the client's words and order. */
const champions = [
  {
    name: 'Building and administration',
    body: 'Our facility continues to evolve to meet the growing needs of the community while fostering a supportive environment for our volunteers and staff.',
  },
  {
    name: 'Community initiatives',
    body: "Our church is dedicated to engaging with the community and meeting its needs, serving as an extension of God's hands in action.",
  },
  {
    name: 'Missions',
    body: 'We support international initiatives that reach vulnerable children in other nations, providing for their basic needs whenever opportunities arise.',
  },
];

const sunday = CHURCH.gatherings.find((g) => g.key === 'sunday')!;
const midweek = CHURCH.gatherings.find((g) => g.key === 'midweek')!;
---

<PageLayout
  title="Life at TTE"
  description={`Ministries, groups and serve teams at The Transformation Edge, a church in ${CHURCH.place}.`}
  route="life-at-tte"
  standfirst="What happens between Sundays, and how to be part of it."
  noindex
>
  <DraftNotice what="1B2GaS needs a description, and Life-Link needs the nights its groups meet. Everything else on this page is confirmed." />

  <div class="life">
    <section aria-labelledby="ministries-heading">
      <h2 id="ministries-heading">Ministries and groups</h2>
      <ul class="ministries" role="list">
        {
          ministries.map((ministry) => (
            <li data-reveal>
              <h3>
                {ministry.href ? <a href={ministry.href}>{ministry.name}</a> : ministry.name}
              </h3>
              <p>{ministry.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- The client's copy of September 2026. The opening line is their own
         framing of what Life-Link is, so it leads. -->
    <section class="feature" aria-labelledby="life-link">
      <h2 id="life-link">Life-Link</h2>
      <p class="feature__lede">The Transformation Edge in your neighbourhood.</p>
      <div class="prose">
        <p>
          Life-Link is a vibrant network that brings people together in meaningful
          geographical groups to foster genuine connection, trust and spiritual growth.
        </p>
        <p>
          Each gathering encourages life-changing conversations that cultivate love, unity
          and a deeper sense of fulfilment in Christ.
        </p>
      </div>

      <!--
        The finder the client asked for. There is no suburb-to-group list yet,
        so rather than a search box that returns nothing, the suburb goes to
        the same Cloudflare Worker the contact form uses and a person replies
        with the nearest group. One field, because one field is all it needs.
        When the group list exists this becomes a lookup and the form goes.
        See docs/forms-and-privacy.md for the Worker.
      -->
      <form class="finder" method="post" action="/api/contact" novalidate aria-labelledby="finder-heading">
        <h3 id="finder-heading" class="finder__heading">Find a Life-Link group in your neighbourhood</h3>
        <input type="hidden" name="subject" value="Life-Link group enquiry" />
        <div class="field">
          <label for="suburb">Your suburb</label>
          <input id="suburb" name="suburb" type="text" autocomplete="address-level2" required />
          <p class="field__hint">
            We will tell you which group is closest and when it meets.
          </p>
        </div>
        <div class="field">
          <label for="finder-contact">Email or phone</label>
          <input id="finder-contact" name="email" type="text" required />
        </div>

        <div class="cf-turnstile" data-sitekey="TURNSTILE_SITE_KEY" data-theme="auto"></div>

        <p class="finder__privacy">
          Your suburb and one contact detail, nothing else, and you are not added to a list.
          Read the <a href="/privacy-policy">privacy policy</a>.
        </p>

        <Button type="submit">Find my group</Button>
      </form>
    </section>

    <!-- The client's copy of September 2026. Section 13 governs it, because
         Champions is a giving commitment: what it pays for, plainly, and the
         receipting position lives on the Give page. -->
    <section class="feature" aria-labelledby="champions">
      <h2 id="champions">Champions</h2>
      <p class="feature__lede">
        Short for the League of Champions, our Kingdom Building Partners.
      </p>
      <div class="prose">
        <p>
          Champions are sacrificial, consistent and committed donors to the ministry of The
          Transformation Edge. Their giving supports three areas of the work.
        </p>
      </div>

      <ol class="champions" role="list">
        {
          champions.map((area, index) => (
            <li data-reveal>
              <span class="champions__number" aria-hidden="true">
                {index + 1}
              </span>
              <div>
                <h3>{area.name}</h3>
                <p>{area.body}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <p class="prose">
        Giving to our church is not a deductible gift, and the Give page says so plainly
        along with the two ways to give.
      </p>
      <p class="actions">
        <Button href="/give">How to give</Button>
        <Button href="/get-in-touch" tone="quiet">Ask about Champions</Button>
      </p>
    </section>

    <section aria-labelledby="gather-heading">
      <h2 id="gather-heading">When we gather</h2>
      <dl class="times">
        <div>
          <dt>Sundays</dt>
          <dd class="ltr-embed">{sunday.time}</dd>
        </div>
        <div>
          <dt>Wednesdays</dt>
          <dd class="ltr-embed">{midweek.time}</dd>
        </div>
      </dl>
    </section>

    <section aria-labelledby="serve-heading">
      <h2 id="serve-heading">Serving</h2>
      <div class="prose">
        <p>
          Most of what happens when we gather is done by the family: welcome, music, sound,
          children's work, coffee, setting up and packing down.
        </p>
        <p>
          If you would like to join a team, say so at the welcome desk or get in touch. Serve
          teams involving children require a Working With Children Check and training before
          you start, and that is not a formality.
        </p>
      </div>
      <Photo
        ref="S8"
        src={serving}
        alt="Hands serving rice and chicken from trays onto plates at a shared meal."
        brief="Hands, mid-serve. Setup, catering, car park, anything practical."
        ratio="1 / 1"
        class="life__photo"
      />

      <p class="actions">
        <Button href="/get-in-touch" size="large">I would like to help</Button>
        <Button href="/who-we-are/safeguarding" tone="quiet">Safeguarding</Button>
      </p>
    </section>

    <section aria-labelledby="connect-heading">
      <h2 id="connect-heading">Groups, rosters and details</h2>
      <p class="prose">
        Rosters, groups, giving and your own details all live in the TTE Connect Hub.
      </p>
      <p class="actions">
        <Button href={CHURCH.connectUrl} tone="quiet" external>Open Connect</Button>
      </p>
    </section>
  </div>
</PageLayout>

<style>
  .life {
    display: grid;
    gap: var(--space-2xl);
    max-inline-size: 46rem;
  }

  .life h2 {
    font-size: var(--text-2);
    margin-block-end: var(--space-s);
  }

  .ministries {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-l);
    margin: 0;
    padding: 0;
  }

  .ministries li {
    padding-block-start: var(--space-s);
    border-block-start: var(--border-thick) solid var(--color-border-strong);
  }

  .ministries h3 {
    font-size: var(--text-1);
    margin-block-end: var(--space-3xs);
  }

  .ministries h3 a {
    color: inherit;
    text-decoration-color: var(--color-border-strong);
  }

  .ministries h3 a:hover {
    text-decoration-color: currentColor;
  }

  .ministries p {
    color: var(--color-text-muted);
  }

  .times {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m) var(--space-2xl);
  }

  .times dt {
    font-size: var(--text--1);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .times dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-2);
  }

  .feature__lede {
    margin-block-end: var(--space-m);
    max-inline-size: var(--measure);
    font-family: var(--font-display);
    font-size: var(--text-1);
    line-height: var(--leading-snug);
    text-wrap: pretty;
  }

  /* The finder sits on a raised ground so it reads as a thing to use rather
     than more prose, without becoming a boxed card. */
  .finder {
    display: grid;
    justify-items: start;
    gap: var(--space-m);
    margin-block-start: var(--space-l);
    padding: var(--space-l);
    max-inline-size: 34rem;
    background-color: var(--color-canvas-raised);
    border-inline-start: var(--border-thick) solid var(--color-text-accent);
    border-radius: var(--radius-m);
  }

  .finder__heading {
    font-size: var(--text-1);
  }

  .field {
    display: grid;
    gap: var(--space-3xs);
    inline-size: 100%;
  }

  .field label {
    font-weight: var(--weight-semibold);
  }

  .field input {
    inline-size: 100%;
    padding: var(--space-2xs) var(--space-xs);
    min-block-size: 2.75rem;
    background-color: var(--color-canvas);
    color: var(--color-text);
    border: var(--border-hairline) solid var(--color-border-strong);
    border-radius: var(--radius-s);
  }

  /* Never micro: rule 4 keeps every hint at body size. */
  .field__hint,
  .finder__privacy {
    font-size: var(--text-0);
    color: var(--color-text-muted);
  }

  .finder__privacy {
    max-inline-size: var(--measure);
  }

  .champions {
    display: grid;
    gap: var(--space-l);
    margin: var(--space-l) 0 var(--space-l);
    padding: 0;
    list-style: none;
  }

  .champions li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-m);
    align-items: start;
    padding-block-start: var(--space-m);
    border-block-start: var(--border-hairline) solid var(--color-border);
  }

  .champions__number {
    font-family: var(--font-display);
    font-size: var(--text-3);
    line-height: 1;
    color: var(--color-text-accent);
  }

  .champions h3 {
    font-size: var(--text-1);
    margin-block-end: var(--space-3xs);
  }

  .champions p {
    max-inline-size: var(--measure);
    color: var(--color-text-muted);
  }

  .life__photo {
    max-inline-size: 22rem;
    margin-block-start: var(--space-l);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-m);
  }
</style>
