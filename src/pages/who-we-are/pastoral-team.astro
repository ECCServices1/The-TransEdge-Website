---
/**
 * Pastoral team, section 9 under Who We Are.
 *
 * The biographies are the client's copy of August 2026, reproduced verbatim,
 * which is what took this page off the draft register. The names and roles
 * still come from src/data/church.mjs; the words about each person came from
 * the people themselves, which is the only acceptable source for them.
 *
 * Section 22 still governs the hardest line on this page: nothing may suggest
 * that pastoral care here is clinical treatment. The earlier version also
 * named Renovate Health as a governance fact; the client removed every
 * reference to it, and to any therapeutic service, in August 2026 (see the
 * note in src/data/church.mjs). The non-clinical line stays; the pointer is
 * gone. The biography's mention of a background in mental health and
 * community care is a fact about a person's working life, not an offer of a
 * service, and it stays on the right side of that line.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/Button.astro';
import Photo from '../../components/Photo.astro';
import seniorPastors from '../../assets/photos/S7-senior-pastors.jpg';
import michaels from '../../assets/photos/S7-michaels.jpg';
import osas from '../../assets/photos/S7-osas.jpg';
import { CHURCH } from '../../data/church.mjs';

/*
  Keyed by name rather than by array position, so reordering the pastors in
  src/data/church.mjs cannot silently swap their photographs or their stories.
  Getting a face or a biography wrong on a page that names people is not a
  layout bug.

  The biography paragraphs are the client's copy, verbatim. The supplied
  headings carried an em-dash between name and role; the page already renders
  name and role as separate elements, so the dash never reaches the copy.
*/
const profiles: Record<
  string,
  { src: ImageMetadata; alt: string; postNominals?: string; bio: string[] }
> = {
  'Dr Michaels Aibangbee': {
    src: michaels,
    alt: 'Dr Michaels Aibangbee teaching, mid-gesture, in a terracotta jacket.',
    postNominals: 'PhD, JP',
    bio: [
      'Michaels leads The Transformation Edge with his wife, Osas. He preaches with clarity and pastoral warmth, shaped by years of work in mental health, community care and academic life. He is an author, and the voice behind the EdgedIn Network production, where teaching, conversation and testimony reach people well beyond Sunday.',
      'His ministry centres on the next generation: seeing young people grow, mature and excel in their walk with God, and raising leaders who carry their faith with conviction into every sphere of life. He believes the local church should be a place where anyone can belong before they have it all worked out.',
      'Michaels and Osas have three children: Ethan, Jayden and Oasis.',
    ],
  },
  'Pastor Osas Aibangbee': {
    src: osas,
    alt: 'Pastor Osas Aibangbee speaking to the gathering, microphone in hand.',
    bio: [
      'Osas leads The Transformation Edge alongside her husband, Michaels. She is the convenor of ReloVance, a ministry devoted to relationships in every form: marriage, singleness, dating, parenting and family. Through honest conversation and practical teaching, ReloVance helps people build connections that last.',
      'Known for her warmth and her straight talk, Osas has a gift for drawing people out of the shadows and into community. She leads with prayer, hospitality and a steady belief that no one should have to carry their story alone.',
      'She serves the congregation with care that reaches beyond the platform, walking with individuals, couples and families through the ordinary and the difficult seasons alike.',
    ],
  },
};
---

<PageLayout
  title="Our Pastors"
  description={`Who leads The Transformation Edge, a church in ${CHURCH.place}, and how to reach them.`}
  route="who-we-are/pastoral-team"
  crumbs={[{ name: 'Who we are', href: '/who-we-are' }]}
  standfirst="Who leads here, and how to reach them without going through a form."
>
  <div class="team">
    <section aria-labelledby="seniors-heading">
      <h2 id="seniors-heading">Our Pastors</h2>
      <!-- The agreed S7: the two of them together and environmental rather
           than studio. Landscape, because that is what the photograph is; a
           portrait crop would have to choose between them. -->
      <Photo
        ref="S7"
        src={seniorPastors}
        alt="The Senior Pastors, Dr Michaels Aibangbee and Pastor Osas Aibangbee, standing together at the lectern during a gathering."
        brief="The senior pastors, together, environmental rather than studio."
        ratio="3 / 2"
        sizes="(min-width: 56rem) 46rem, 100vw"
        class="team__photo"
      />

      <ul class="people" role="list">
        {
          CHURCH.seniorPastors.map((pastor) => {
            const profile = profiles[pastor.name];
            return (
              <li class="person" data-reveal>
                {profile && (
                  <Photo
                    ref="S7"
                    src={profile.src}
                    alt={profile.alt}
                    brief={`Portrait of ${pastor.name}.`}
                    ratio="4 / 5"
                    sizes="(min-width: 56rem) 18rem, 100vw"
                    class="person__photo"
                  />
                )}
                <div class="person__words">
                  <h3 class="person__name">
                    {pastor.name}
                    {profile?.postNominals && (
                      <span class="person__creds">{profile.postNominals}</span>
                    )}
                  </h3>
                  <p class="person__role">{pastor.role}</p>
                  {profile && (
                    <div class="person__bio">
                      {profile.bio.map((paragraph) => (
                        <p>{paragraph}</p>
                      ))}
                    </div>
                  )}
                </div>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section aria-labelledby="reach-heading">
      <h2 id="reach-heading">Reaching a pastor</h2>
      <div class="prose">
        <p>
          Call <a href={`tel:${CHURCH.phoneE164}`} class="ltr-embed">{CHURCH.phone}</a> or
          email <a href={`mailto:${CHURCH.email}`}>{CHURCH.email}</a> and ask. Somebody reads
          everything that comes in and replies within two working days.
        </p>
        <p>
          If what you want is prayer rather than a conversation, there is a private route for
          that which goes to the pastoral team and nowhere else.
        </p>
      </div>
      <p class="actions">
        <Button href="/get-in-touch/prayer" tone="quiet">Ask for prayer</Button>
        <Button href="/get-in-touch">Get in touch</Button>
      </p>
    </section>

    <!-- The distinction section 22 exists to protect. Pastoral care is not
         clinical treatment, and the page says so rather than leaving a reader
         to assume it either way. -->
    <section aria-labelledby="separate-heading">
      <h2 id="separate-heading">Pastoral care</h2>
      <p class="prose">
        Pastoral care here means someone sitting with you, praying with you and walking
        alongside you. It is care, not clinical treatment, and we do not present it as
        such.
      </p>
    </section>
  </div>
</PageLayout>

<style>
  .team {
    display: grid;
    gap: var(--space-2xl);
    max-inline-size: 46rem;
  }

  .team h2 {
    font-size: var(--text-2);
    margin-block-end: var(--space-s);
  }

  .team__photo {
    margin-block-end: var(--space-l);
  }

  /* One pastor per row: the biographies are real now, and three paragraphs
     do not belong in a card. Portrait beside the words on a wide screen,
     stacked on a phone. */
  .people {
    display: grid;
    gap: var(--space-2xl);
    margin: 0;
    padding: 0;
  }

  .person {
    display: grid;
    gap: var(--space-l);
    padding-block-start: var(--space-l);
    border-block-start: var(--border-thick) solid var(--color-border-strong);
  }

  @media (min-width: 56rem) {
    .person {
      grid-template-columns: 18rem 1fr;
      align-items: start;
    }
  }

  .person__photo {
    max-inline-size: 18rem;
  }

  .person__name {
    font-size: var(--text-2);
    margin-block-end: var(--space-3xs);
  }

  .person__creds {
    margin-inline-start: var(--space-2xs);
    font-family: var(--font-text);
    font-size: var(--text--1);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .person__role {
    font-size: var(--text--1);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .person__bio {
    margin-block-start: var(--space-s);
    max-inline-size: var(--measure);
  }

  .person__bio > p + p {
    margin-block-start: var(--space-m);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-m);
  }
</style>
