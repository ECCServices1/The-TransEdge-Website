---
/**
 * What we believe, section 9 under Who We Are.
 *
 * The nine articles below are the client's statement of faith, supplied in
 * September 2026 and reproduced verbatim (a stray second full stop at the end
 * of the ninth article removed). That is what took this page off the draft
 * register: a statement of faith is the one piece of content on a church
 * website that cannot be inferred, and until the client supplied it the page
 * said so instead of guessing.
 *
 * The vision and the mission remain locked and are reproduced from
 * src/data/church.mjs.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/Button.astro';
import { VISION, MISSION, CHURCH } from '../../data/church.mjs';

/* The client's headings and wording, in the client's order. Numbered on the
   page because the client numbered them. */
const articles = [
  {
    title: 'About the Bible',
    body: "We believe that the Bible is God's Word. It is accurate, authoritative and applicable to our everyday lives.",
  },
  {
    title: 'God',
    body: 'We believe in one eternal God who is the Creator of all things. He exists in three Persons: God the Father, God the Son and God the Holy Spirit. He is totally loving and completely holy.',
  },
  {
    title: 'Sin',
    body: 'We believe that sin has separated each of us from God and His purpose for our lives.',
  },
  {
    title: 'Jesus Christ',
    body: 'We believe that the Lord Jesus Christ as both God and man is the only One who can reconcile us to God. He lived a sinless and exemplary life, died on the cross in our place, and rose again to prove His victory and empower us for life.',
  },
  {
    title: 'New Birth',
    body: "We believe that in order to receive forgiveness and the 'new birth' we must repent of our sins, believe in the Lord Jesus Christ, and submit to His will for our lives.",
  },
  {
    title: 'Baptism',
    body: 'We believe that in order to live the holy and fruitful lives that God intends for us, we need to be baptised in water and be filled with the power of the Holy Spirit. The Holy Spirit enables us to use spiritual gifts, including speaking in tongues which is the initial evidence of baptism in the Holy Spirit.',
  },
  {
    // "The Church" here is the church universal, the one sense the "our
    // church" rule deliberately leaves alone.
    title: 'Member of the Church', // check-copy-ignore
    body: 'We believe that God has individually equipped us so that we can successfully achieve His purpose for our lives which is to worship God, fulfil our role in the Church and serve the community in which we live.', // check-copy-ignore
  },
  {
    title: 'Second Coming',
    body: 'We believe that the Lord Jesus Christ is coming back again as He promised.',
  },
  {
    title: 'Eternity',
    body: 'We believe that our eternal destination of either Heaven or hell is determined by our response to the Lord Jesus Christ.',
  },
];
---

<PageLayout
  title="What we believe"
  description={`What The Transformation Edge believes: nine articles of faith, in plain words. A church in ${CHURCH.place}.`}
  route="who-we-are/what-we-believe"
  crumbs={[{ name: 'Who we are', href: '/who-we-are' }]}
  standfirst="Nine articles of faith, stated plainly."
>
  <div class="believe">
    <section aria-labelledby="articles-heading">
      <h2 id="articles-heading">Our statement of faith</h2>
      <ol class="articles" role="list">
        {
          articles.map((article, index) => (
            <li class="articles__item" data-reveal>
              <span class="articles__number" aria-hidden="true">
                {index + 1}
              </span>
              <div>
                <h3>{article.title}</h3>
                <p>{article.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="vision-heading">
      <h2 id="vision-heading">Our vision</h2>
      <blockquote class="statement"><p>{VISION}</p></blockquote>
    </section>

    <section aria-labelledby="mission-heading">
      <h2 id="mission-heading">Our mission</h2>
      <blockquote class="statement"><p>{MISSION}</p></blockquote>
    </section>

    <section aria-labelledby="questions-heading">
      <h2 id="questions-heading">If you are working out what you think</h2>
      <p class="prose">
        You are welcome here while you do it. Nobody is asked to sign or declare anything to
        come on a Sunday. If you would like to go through it properly, the CORE Course is
        where people start.
      </p>
      <p class="actions">
        <Button href="/who-we-are/core-course" tone="quiet">The CORE Course</Button>
        <Button href="/get-in-touch">Ask us something</Button>
      </p>
    </section>
  </div>
</PageLayout>

<style>
  .believe {
    display: grid;
    gap: var(--space-2xl);
    max-inline-size: 46rem;
  }

  .believe h2 {
    font-size: var(--text-2);
    margin-block-end: var(--space-s);
  }

  .statement {
    margin: 0;
    max-inline-size: 40rem;
  }

  .statement p {
    font-family: var(--font-display);
    font-size: var(--text-1);
    line-height: var(--leading-snug);
    text-wrap: pretty;
  }

  .articles {
    display: grid;
    gap: var(--space-l);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .articles__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-m);
    align-items: start;
    padding-block-start: var(--space-m);
    border-block-start: var(--border-hairline) solid var(--color-border);
  }

  .articles__number {
    font-family: var(--font-display);
    font-size: var(--text-3);
    line-height: 1;
    color: var(--color-text-accent);
  }

  .articles__item h3 {
    font-family: var(--font-display);
    font-size: var(--text-1);
    font-weight: var(--weight-semibold);
    margin-block-end: var(--space-3xs);
  }

  .articles__item p {
    max-inline-size: var(--measure);
    color: var(--color-text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-m);
  }
</style>
