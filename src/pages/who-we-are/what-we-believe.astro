---
/**
 * What we believe, section 9 under Who We Are.
 *
 * This page is drafted, not written. A statement of faith is the one piece of
 * content on a church website that absolutely cannot be inferred, and inferring
 * it from the name, the mission and the general shape of the tradition would
 * produce something that reads exactly like a real one while being nobody's
 * actual conviction.
 *
 * So the articles below are a starting structure in plain language, drawn from
 * what the locked vision and mission already commit to, and the page carries
 * `noindex` until the pastoral team has rewritten them in their own words.
 *
 * What is not drafted: the vision and the mission, which are locked and
 * reproduced from src/data/church.mjs.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/Button.astro';
import DraftNotice from '../../components/DraftNotice.astro';
import { VISION, MISSION, CHURCH } from '../../data/church.mjs';

/*
 * Each article states only what the locked mission and vision already commit us
 * to, in plain language. Nothing here settles a question the pastoral team has
 * not settled in public: there is deliberately no article on baptism,
 * communion, church government, spiritual gifts or eschatology, because those
 * are the positions that differ between churches in the same tradition, and
 * guessing one is how a website misrepresents its own congregation.
 */
const articles = [
  {
    title: 'God',
    body: 'We believe in one God, who made everything that exists, who is good, and who is knowable rather than distant.',
  },
  {
    title: 'Jesus',
    body: 'We believe Jesus Christ is the Son of God, that he lived, died and rose again, and that following him is what a Christian life is built on. Our mission puts it plainly: to discover, develop and empower individuals to become faithful disciples of Jesus Christ.',
  },
  {
    title: 'The Bible',
    body: "We believe the Bible is God's word, that it carries authority over how we live, and that the knowledge and wisdom it holds is meant to shape every area of life rather than a religious corner of it.",
  },
  {
    title: 'The Gospel',
    body: 'We believe the Gospel has power to change a person and, through changed people, a community. That is why our mission is to equip believers to influence their communities through the power of the Gospel.',
  },
  {
    title: 'People',
    body: 'We believe every person is made in the image of God and carries that dignity whatever their circumstances, their documents, their history or their language.',
  },
  {
    // Both lines mean the church universal, which is the one sense the
    // "our church" rule deliberately leaves alone.
    title: 'The church', // check-copy-ignore
    body: 'We believe the church is people rather than a building, and that it exists for the sake of those outside it as much as those inside it.', // check-copy-ignore
  },
];
---

<PageLayout
  title="What we believe"
  description={`The convictions The Transformation Edge is built on, in plain language. A church in ${CHURCH.place}.`}
  route="who-we-are/what-we-believe"
  crumbs={[{ name: 'Who we are', href: '/who-we-are' }]}
  standfirst="Six convictions, in plain words, with nothing hidden behind them."
  noindex
>
  <DraftNotice what="The pastoral team needs to write the articles below in their own words. What is here is a structure drawn from the locked vision and mission, not an approved statement of faith." />

  <div class="believe">
    <section aria-labelledby="vision-heading">
      <h2 id="vision-heading">Our vision</h2>
      <blockquote class="statement"><p>{VISION}</p></blockquote>
    </section>

    <section aria-labelledby="mission-heading">
      <h2 id="mission-heading">Our mission</h2>
      <blockquote class="statement"><p>{MISSION}</p></blockquote>
    </section>

    <section aria-labelledby="articles-heading">
      <h2 id="articles-heading">What that means</h2>
      <dl class="articles">
        {
          articles.map((article) => (
            <div data-reveal>
              <dt>{article.title}</dt>
              <dd>{article.body}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="questions-heading">
      <h2 id="questions-heading">If you are working out what you think</h2>
      <p class="prose">
        You are welcome here while you do it. Nobody is asked to sign anything, agree to
        anything or declare anything to come on a Sunday. If you would like to go through it
        properly rather than in passing, the CORE Course is where people start.
      </p>
      <p class="actions">
        <Button href="/who-we-are/core-course" tone="quiet">The CORE Course</Button>
        <Button href="/get-in-touch">Ask us something</Button>
      </p>
    </section>
  </div>
</PageLayout>

<style>
  .believe {
    display: grid;
    gap: var(--space-2xl);
    max-inline-size: 46rem;
  }

  .believe h2 {
    font-size: var(--text-2);
    margin-block-end: var(--space-s);
  }

  .statement {
    margin: 0;
    max-inline-size: 40rem;
  }

  .statement p {
    font-family: var(--font-display);
    font-size: var(--text-1);
    line-height: var(--leading-snug);
    text-wrap: pretty;
  }

  .articles {
    display: grid;
    gap: var(--space-l);
    margin: 0;
  }

  .articles > div {
    padding-block-start: var(--space-m);
    border-block-start: var(--border-hairline) solid var(--color-border);
  }

  .articles dt {
    font-family: var(--font-display);
    font-size: var(--text-1);
    font-weight: var(--weight-semibold);
    margin-block-end: var(--space-3xs);
  }

  .articles dd {
    margin: 0;
    max-inline-size: var(--measure);
    color: var(--color-text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-m);
  }
</style>
