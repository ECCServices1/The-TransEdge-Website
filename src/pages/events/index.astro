---
/**
 * Events index. Read from Connect, presented in the template each record asks
 * for, registration handing back to Connect.
 *
 * Only what is active or upcoming renders, and a script in the list removes
 * anything that has ended since the build. The empty state is real content
 * rather than an apology: the standing gatherings are always true, so a
 * visitor who arrives in a quiet week still learns when the doors are open.
 * It is rendered hidden whenever there are events, so the client-side expiry
 * can reveal it without a rebuild.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/Button.astro';
import EventList from '../../components/events/EventList.astro';
import { getUpcomingEvents } from '../../lib/connect.mjs';
import { eventSchema } from '../../lib/structured-data.mjs';
import { CHURCH } from '../../data/church.mjs';

const events = await getUpcomingEvents();
---

<PageLayout
  title="Events"
  description="What is coming up at The Transformation Edge in Penrith, Sydney."
  route="events"
  standfirst="Everything in the diary, and what to do if you want to come."
  schema={events.map(eventSchema)}
>
  {events.length > 0 && <EventList events={events} headingLevel={2} />}

  <section class="empty" aria-labelledby="empty-heading" hidden={events.length > 0} data-events-empty>
    <h2 id="empty-heading">Nothing extra in the diary just now</h2>
    <p class="prose">The regular gatherings are always on, and everyone is welcome at both.</p>
    <dl class="empty__standing">
      {
        CHURCH.gatherings.map((g) => (
          <div>
            <dt>{g.day}</dt>
            <dd class="ltr-embed">{g.time}</dd>
          </div>
        ))
      }
    </dl>
    <p>
      <Button href="/new-here/plan-your-visit">Plan your visit</Button>
    </p>
  </section>
</PageLayout>

<style>
  .empty {
    max-inline-size: 40rem;
  }

  .empty h2 {
    font-size: var(--text-2);
    margin-block-end: var(--space-s);
  }

  .empty__standing {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m) var(--space-2xl);
    margin-block: var(--space-l);
  }

  .empty__standing dt {
    font-size: var(--text--1);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .empty__standing dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-2);
  }
</style>
